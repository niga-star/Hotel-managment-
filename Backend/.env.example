# Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_here
BASE_URL=http://localhost:5000

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hotel_management_db

# Chapa Payment Gateway (Ethiopia)
CHAPA_PUBLIC_KEY=CHAPUBK_TEST-xxx
CHAPA_SECRET_KEY=CHASECK_TEST-xxx
CHAPA_WEBHOOK_SECRET=your_webhook_secret
CHAPA_API_URL=https://api.chapa.co/v1

# Telebirr (Ethio Telecom Mobile Money)
TELEBIRR_APP_ID=your_telebirr_app_id
TELEBIRR_APP_KEY=your_telebirr_app_key
TELEBIRR_SHORT_CODE=100223
TELEBIRR_NOTIFY_URL=http://localhost:5000/api/v1/payments/webhook/telebirr

# Commercial Bank of Ethiopia (CBE Birr)
CBE_BIRR_MERCHANT_CODE=CBE_MERCH_xxx
CBE_BIRR_API_KEY=your_cbe_api_key

# Email Notifications (SMTP / Nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=reservations@example.com
SMTP_PASS=your_email_password
SMTP_FROM="Ethiopian Boutique Resorts & Luxury Stays" <reservations@example.com>

# SMS Gateway
ETHIO_SMS_API_KEY=your_sms_api_key
ETHIO_SMS_SENDER_ID=ETHIO_HOTEL
